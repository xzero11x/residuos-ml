---
import '../styles/global.css';
export const prerender=true;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Panel de aportes · BaguaLimpia</title></head><body><header><a class="brand" href="/">bagua<span class="brand-light">circular</span>.</a><a class="text-link" href="/#comunidad">Ver blog ↗</a></header><main class="wrap section"><div class="eyebrow">ADMINISTRACIÓN</div><h1 style="font-size:40px">Aportes de la comunidad</h1><p>Revisa lo que comparten los participantes de la exposición.</p><form id="login" style="max-width:400px"><label for="password">Contraseña del administrador</label><input id="password" type="password" autocomplete="current-password" required style="display:block;width:100%;padding:14px;margin:15px 0;border:1px solid #b9c5ac;border-radius:6px"/><button class="button">Entrar al panel ↗</button></form><p id="status" role="status"></p><section id="panel" hidden><div class="blog-tools"><span id="total"></span><input id="query" type="search" aria-label="Buscar aportes" placeholder="Buscar aportes…"/><button class="text-link" id="reload">↻ Actualizar</button><button class="text-link" id="download">Descargar JSON</button><button class="text-link" id="logout">Cerrar sesión</button></div><div id="list" class="cards three" style="margin-top:25px"></div></section></main><script>
type Post={id:string;author:string;title:string;content:string;category:string;created_at:string};
let posts:Post[]=[];
const get=(id:string)=>document.getElementById(id)!;
async function load(){try{const r=await fetch('/api/admin/posts',{cache:'no-store'});if(r.status===401){get('login').hidden=false;get('panel').hidden=true;return;}if(!r.ok)throw Error();posts=(await r.json()).posts;get('login').hidden=true;get('panel').hidden=false;get('status').textContent='Conectado al almacenamiento de tu PC · Actualización cada 10 segundos';render();}catch{get('status').textContent='No se pudo conectar con el servidor.';}}
function render(){get('total').textContent=`${posts.length} aportes recibidos`;const q=(get('query') as HTMLInputElement).value.toLowerCase();get('list').replaceChildren();for(const p of posts.filter(p=>`${p.author} ${p.title} ${p.content} ${p.category}`.toLowerCase().includes(q))){const card=document.createElement('article');card.className='post-card';const title=document.createElement('h3');title.textContent=p.title;const content=document.createElement('p');content.textContent=p.content;const meta=document.createElement('div');meta.className='post-meta';meta.textContent=`${p.dni?'DNI '+p.dni+' · ':''}${p.author}${p.sector?' · '+p.sector:''} · ${p.category} · ${new Date(p.created_at).toLocaleString('es-PE')}`;const del=document.createElement('button');del.className='text-link';del.textContent='Eliminar aporte';del.addEventListener('click',async()=>{if(!confirm('¿Eliminar este aporte de forma permanente?'))return;const r=await fetch('/api/admin/posts/'+p.id,{method:'DELETE'});if(r.ok)await load();else get('status').textContent='No se pudo eliminar. Vuelve a iniciar sesión.';});card.append(title,content,meta,del);get('list').append(card);}}
get('login').addEventListener('submit',async e=>{e.preventDefault();try{const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:(get('password') as HTMLInputElement).value})});const data=await r.json();if(!r.ok){get('status').textContent=data.error;return;}(get('password') as HTMLInputElement).value='';await load();}catch{get('status').textContent='No se pudo conectar.';}});
get('reload').addEventListener('click',load);get('query').addEventListener('input',render);get('logout').addEventListener('click',async()=>{await fetch('/api/admin/logout',{method:'POST'});await load();});get('download').addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(posts,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='aportes-bagua.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});setInterval(()=>{if(!document.hidden&&!get('panel').hidden)load();},10000);load();
</script></body></html>
